# Local Docker/Podman Compose only. Copy to .env at the repository root.
# Compose passes database settings to the backend containers explicitly.
DB_PASSWORD=whoshot_local
API_DB_PASSWORD=whoshot_api_local
INGEST_DB_PASSWORD=whoshot_ingest_local
DB_PORT=5432
API_PORT=8080
FRONTEND_PORT=3000
DATA_JOB_PROFILE=local
# Subnet prefix of the network Caddy uses. Only change it for a second stack on the same
# machine (another worktree), e.g. 172.30.251.
# EDGE_NET=172.30.250

# Linux Docker: set these to your host UID/GID (id -u / id -g).
LOCAL_UID=1000
LOCAL_GID=1000

# Optional: Web3Forms access key for the Feedback form (build time).
# VITE_WEB3FORMS_ACCESS_KEY=your-access-key

# Optional: Stripe "customers choose what to pay" Payment Links for the
# Donations page, one per currency (build time). Currencies without a link are
# not offered.
# VITE_DONATION_URL_SEK=https://buy.stripe.com/your-sek-link
# VITE_DONATION_URL_EUR=https://buy.stripe.com/your-eur-link
# VITE_DONATION_URL_USD=https://buy.stripe.com/your-usd-link

# Production monitoring, used with `--profile prod`. Values come from the
# Grafana Cloud stack; see monitoring/README.md. METRICS_PUSH_ENABLED makes the data
# job push its metrics to the agent.
# METRICS_PUSH_ENABLED=true
# GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-xx-prod-eu-west-x.grafana.net/api/prom/push
# GRAFANA_CLOUD_PROMETHEUS_USER=123456
# GRAFANA_CLOUD_LOKI_URL=https://logs-prod-xxx.grafana.net/loki/api/v1/push
# GRAFANA_CLOUD_LOKI_USER=654321
# GRAFANA_CLOUD_API_TOKEN=glc_...
