# Public entry point in production (issue #21): TLS, security headers and access logs,
# in front of the frontend's nginx, which serves the SPA and proxies /api/.
# SITE_DOMAIN comes from the server's .env through compose.

{
	# The admin API would otherwise listen on localhost:2019, where the metrics site
	# below listens. Config changes take a container restart instead of a reload.
	admin off
	metrics

	# Proxy failures use the default logger, independently of the access logger.
	log default {
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
			}
		}
	}

	# Drop clients that send headers or bodies slowly to hold connections open.
	servers {
		timeouts {
			read_header 10s
			read_body 10s
			write 30s
			idle 2m
		}
	}
}

# Declare HTTP during adaptation so the global server timeouts also cover the
# HTTPS redirect and ACME challenge listener (automatic HTTPS adds their routes).
http:// {
}

# Internal only: compose does not publish 2019; the monitoring agent scrapes caddy:2019.
:2019 {
	metrics /metrics
}

{$SITE_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	log {
		output stdout
		# Keep status, duration and sizes, but discard client-controlled request
		# text and response headers before logs leave the process (issue #58).
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
			}
		}
	}

	# The site only serves reads; nginx enforces the same limit behind this one.
	request_body {
		max_size 16KB
	}

	reverse_proxy frontend:3000
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
