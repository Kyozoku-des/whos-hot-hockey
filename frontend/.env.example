# API Configuration
#
# Leave this unset for normal development and for the container build. The app
# defaults to a relative /api base, which the Vite dev server (vite.config.js)
# and nginx (frontend/nginx.conf) both proxy to the backend on port 8080.
#
# Only set it to point the SPA at a backend on a different origin. Vite inlines
# import.meta.env at BUILD time, so this has no effect as a runtime container
# env var, and the value must already include the /api suffix.
#
# VITE_API_BASE_URL=http://localhost:8080/api

# Feedback
#
# Web3Forms access key (https://web3forms.com, free tier) for the Feedback
# form; submissions are emailed to the address the key was created for. The key
# is a public form ID, not a secret, so it is fine in the bundle. Left unset,
# the form is shown disabled. Inlined at BUILD time.
#
# VITE_WEB3FORMS_ACCESS_KEY=your-access-key
