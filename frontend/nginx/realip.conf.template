# Trust only Caddy's immediate peer address, not the whole Docker subnet.
# unix: trusts no TCP peers (this server listens on TCP only).
set_real_ip_from ${CADDY_TRUSTED_PROXY};
real_ip_header X-Forwarded-For;
# Caddy is the only trusted hop and writes the client as the last XFF address.
# Do not walk further into a client-supplied chain.
real_ip_recursive off;
