{
  "title": "Who's Hot Hockey overview",
  "uid": "whos-hot-hockey-overview",
  "tags": [
    "whos-hot-hockey"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Requests per second (Caddy)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(caddy_http_request_duration_seconds_count{environment=\"prod\"}[5m]))",
          "legendFormat": "{{code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "All visitor requests through Caddy, by HTTP status code.",
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "API requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{environment=\"prod\", job=\"whos-hot-hockey-api\", uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "API average response time",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{environment=\"prod\", job=\"whos-hot-hockey-api\", uri!~\"/actuator.*\"}[5m])) / sum by (uri) (rate(http_server_requests_seconds_count{environment=\"prod\", job=\"whos-hot-hockey-api\", uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{uri}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 4
    },
    {
      "type": "row",
      "title": "Server",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": [],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "CPU used",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(rate(node_cpu_seconds_total{environment=\"prod\", mode=\"idle\"}[5m]))",
          "legendFormat": "cpu",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Memory used",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_memory_MemAvailable_bytes{environment=\"prod\"} / node_memory_MemTotal_bytes{environment=\"prod\"}",
          "legendFormat": "memory",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Disk used",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - min(node_filesystem_avail_bytes{environment=\"prod\", fstype=~\"ext4|xfs|btrfs\"} / node_filesystem_size_bytes{environment=\"prod\", fstype=~\"ext4|xfs|btrfs\"})",
          "legendFormat": "disk",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 8
    },
    {
      "type": "row",
      "title": "Containers",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": [],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Memory by service",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (container_memory_working_set_bytes{environment=\"prod\", project=\"${compose_project}\"})",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "CPU by service",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(container_cpu_usage_seconds_total{environment=\"prod\", project=\"${compose_project}\"}[5m]))",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "CPU cores in use per service.",
      "id": 11
    },
    {
      "type": "row",
      "title": "Data ingestion",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": [],
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Hours since last complete run",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - max by (mode) (ingestion_last_success{environment=\"prod\"})) / 3600",
          "legendFormat": "{{mode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "A run with skipped or deferred records doesn't count; the 'Ingestion stale' alert fires at 6 hours.",
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Records per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(ingestion_records_total{environment=\"prod\"}[5m])) * 60",
          "legendFormat": "{{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "NHL API requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_uid}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(nhl_api_requests_milliseconds_count{environment=\"prod\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_uid}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 15
    },
    {
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "panels": [],
      "id": 16
    },
    {
      "type": "logs",
      "title": "Errors and warnings",
      "datasource": {
        "type": "loki",
        "uid": "${loki_uid}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki_uid}"
          },
          "expr": "{environment=\"prod\", project=\"${compose_project}\", level=~\"error|warn\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "id": 17
    }
  ]
}
