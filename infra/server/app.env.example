# Server secrets and settings: /opt/whoshot/app.env, owned by deploy, mode 600.
# Never commit the filled-in copy; keep it in Bitwarden. The deploy script adds
# APP_PROFILE=prod and IMAGE_TAG itself.

# Your own strong password. Postgres sets it on first start; changing it later does
# not change the password of the existing database.
DB_PASSWORD=

# Separate runtime passwords, each at least 20 characters and all three distinct.
# Install these BEFORE deploying the issue #58 database-role change. The one-shot
# provisioning service sets/rotates them on fresh and existing databases.
API_DB_PASSWORD=
INGEST_DB_PASSWORD=

# Domain Caddy serves and gets certificates for (www. redirects to it).
SITE_DOMAIN=

# Monitoring (issue #70); see monitoring/README.md.
METRICS_PUSH_ENABLED=true
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_API_TOKEN=
