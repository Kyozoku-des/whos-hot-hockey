#cloud-config
# First boot only (issue #21). Terraform ignores later changes to this file, so apply
# changes to a running server by hand; see README.md.

package_update: true
package_upgrade: true
packages:
  - docker.io
  - docker-compose-v2
  - unattended-upgrades

swap:
  filename: /swapfile
  size: 2G

users:
  - name: ${admin_user}
    groups: [sudo]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${admin_ssh_public_key}
  # CI logs in as this user. The key is pinned to the deploy script: no shell, no
  # forwarding, so a leaked key can only redeploy images CI already built.
  - name: deploy
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - restrict,command="/usr/local/bin/whoshot-deploy" ${deploy_ssh_public_key}

write_files:
  - path: /etc/ssh/sshd_config.d/10-hardening.conf
    permissions: "0644"
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      AllowUsers ${admin_user} deploy
      X11Forwarding no
      MaxAuthTries 3

  # Rotate container logs; the monitoring agent ships them off the server anyway.
  # live-restore keeps containers running while unattended-upgrades updates Docker.
  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "10m", "max-file": "3" },
        "live-restore": true
      }

  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: "0644"
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      APT::Periodic::AutocleanInterval "7";

  # Security updates are on by default; also take -updates, where Ubuntu ships Docker
  # fixes. Reboot when a kernel update needs it; containers restart on their own.
  - path: /etc/apt/apt.conf.d/52unattended-upgrades-local
    permissions: "0644"
    content: |
      Unattended-Upgrade::Allowed-Origins {
        "$${distro_id}:$${distro_codename}-updates";
      };
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-Time "${unattended_reboot_time}";
      Unattended-Upgrade::Remove-Unused-Dependencies "true";

  - path: /usr/local/bin/whoshot-deploy
    permissions: "0755"
    encoding: b64
    content: ${deploy_script}

runcmd:
  - usermod -aG docker ${admin_user}
  - usermod -aG docker deploy
  - install -d -o deploy -g deploy -m 0750 /opt/whoshot /opt/whoshot/releases
  - systemctl enable --now docker
  - systemctl restart ssh
