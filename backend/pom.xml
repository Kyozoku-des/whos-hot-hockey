<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.whoshot.nhl</groupId>
    <artifactId>whos-hot-nhl</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Who's Hot</name>
    <description>NHL Statistics - Multi-module project</description>

    <modules>
        <module>domain</module>
        <module>data-job</module>
        <module>api</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.proc>full</maven.compiler.proc>
        <!-- Lombok, maven-compiler-plugin and Testcontainers versions are managed by the Boot parent.
             Boot 4.1.1 manages Testcontainers 2.0.5, which already negotiates a Docker API version
             accepted by Docker Engine 29+, so the former 1.21.4 override is no longer needed. -->
        <!-- Security patch overrides on top of Boot 4.1.1's managed versions. Remove each one once
             the Boot parent manages an equal or newer version.
             Tomcat 11.0.24: CVE-2026-65905, CVE-2026-68525, CVE-2026-65182 (fixed in 11.0.25).
             Jackson 3.1.5 / 2.21.5: CVE-2026-91777, CVE-2026-91776, CVE-2026-68497, CVE-2026-83557,
             CVE-2026-19032, CVE-2026-89425, CVE-2026-89407 (fixed in 3.1.7 / 2.21.7). Jackson 2 is
             still pulled in transitively by springdoc's swagger-core. -->
        <tomcat.version>11.0.26</tomcat.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <!-- Build-time only: libraries the Maven plugins load, not shipped in the jars (issue #58).
             plexus-utils 3.5.1/3.6.0/4.0.2: CVE-2025-67030 (fixed in 3.6.1 / 4.0.3).
             commons-io 2.11.0: CVE-2024-47554. commons-lang3 3.16.0: CVE-2025-48924.
             spring-boot-maven-plugin still pulls Jackson 3.1.5 through buildpack-platform. -->
        <plugin.plexus-utils-3.version>3.6.2</plugin.plexus-utils-3.version>
        <plugin.plexus-utils-4.version>4.0.3</plugin.plexus-utils-4.version>
        <plugin.commons-io.version>2.22.0</plugin.commons-io.version>
        <plugin.commons-lang3.version>3.21.0</plugin.commons-lang3.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Common module dependency for other modules -->
            <dependency>
                <groupId>com.whoshot.nhl</groupId>
                <artifactId>domain</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <dependencies>
                        <dependency>
                            <groupId>tools.jackson.core</groupId>
                            <artifactId>jackson-databind</artifactId>
                            <version>${jackson-bom.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>tools.jackson.core</groupId>
                            <artifactId>jackson-core</artifactId>
                            <version>${jackson-bom.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>${plugin.plexus-utils-3.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>commons-io</groupId>
                            <artifactId>commons-io</artifactId>
                            <version>${plugin.commons-io.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.apache.commons</groupId>
                            <artifactId>commons-lang3</artifactId>
                            <version>${plugin.commons-lang3.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <dependencies>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>${plugin.plexus-utils-4.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <dependencies>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>${plugin.plexus-utils-3.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <dependencies>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>${plugin.plexus-utils-4.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>commons-io</groupId>
                            <artifactId>commons-io</artifactId>
                            <version>${plugin.commons-io.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <proc>${maven.compiler.proc}</proc>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
