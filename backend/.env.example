# Copy to backend/.env for local Java runs from backend/.
# This is read as Java properties: plain KEY=value, no quotes or 'export'.
# Use forward slashes in paths. Real process environment variables take precedence.
DB_URL=jdbc:postgresql://localhost:5432/nhl_stats
DB_USER=whoshot
DB_PASSWORD=whoshot_local
LOG_DIRECTORY=./logs
# API only; use a matching frontend proxy target if changing this.
SERVER_PORT=8080
